[Unit]
Description=Millennium research compute worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=4
ExecStart=__REPO__/.venv/bin/python scripts/vm/vm_worker.py
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
